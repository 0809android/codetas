{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CODETAS Validation",
  "version": "0.1.0",
  "identifier": "jp.kinocode.codetas.validation",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev",
    "devUrl": "http://127.0.0.1:4179",
    "beforeBuildCommand": "npm --prefix ../.. run build --workspace @codetas/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CODETAS Validation — Isolated Test",
        "width": 1320,
        "height": 860,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["app"],
    "shortDescription": "CODETAS isolated validation build",
    "longDescription": "An isolated test build that does not use the normal CODETAS app data, Codex home, or OS service."
  }
}
