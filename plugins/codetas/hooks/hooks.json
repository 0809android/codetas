{
  "description": "Load reviewable Hermes project context and run the profile-scoped learning loop.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/learning_hook.py\" SessionStart",
            "timeout": 10,
            "statusMessage": "CODETAS: プロファイル学習コンテキストを確認中",
            "additionalContextLimit": 20000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/learning_fast.sh\" UserPromptSubmit",
            "timeout": 2,
            "statusMessage": "CODETAS: 学習ターンを記録中"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/learning_fast.sh\" PostToolUse",
            "timeout": 2,
            "statusMessage": "CODETAS: スキル学習カウンタを更新中"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/learning_fast.sh\" Stop",
            "timeout": 2,
            "statusMessage": "CODETAS: 学習状態を保存中"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/learning_hook.py\" SessionEnd",
            "timeout": 3,
            "statusMessage": "CODETAS: 学習状態を保存中"
          }
        ]
      }
    ]
  }
}
