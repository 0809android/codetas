#!/usr/bin/env sh
# Thin Unix wrapper: locate Python 3.10+ and run learning_hook.py.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
HOOK="$ROOT/hooks/learning_hook.py"
probe() {
  "$1" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1
}
for bin in python3 python; do
  if command -v "$bin" >/dev/null 2>&1 && probe "$bin"; then
    exec "$bin" "$HOOK" "$@"
  fi
done
echo "CODETAS: Python 3.10+ not found" >&2
exit 127
